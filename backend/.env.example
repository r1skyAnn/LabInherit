# ============ 应用 ============
APP_NAME=LabInherit
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS 来源（开发期通常就是 Vite 的 5173）
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 用于密码重置邮件中的链接
APP_BASE_URL=http://localhost:5173

# ============ 数据库 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=labinherit
DB_PASSWORD=labinherit_dev
DB_NAME=labinherit
DB_ECHO=false

# ============ JWT（S1 起使用）============
JWT_SECRET=please-change-me-to-a-32-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============ SMTP（S4 起使用）============
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@labinherit.local
SMTP_TLS=true

# ============ 看板规则 ============
STALE_DAYS=90

# ============ Worker（S4 起使用）============
EMAIL_WORKER_POLL_INTERVAL=5
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_MAX_RETRIES=5

# ============ 上传文件 ============
# 开发期默认 ./uploads，部署时可改为绝对路径如 /data/labinherit/uploads
UPLOAD_DIR=./uploads
