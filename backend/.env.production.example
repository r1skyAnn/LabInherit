# ============ 应用 ============
APP_NAME=LabInherit
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS 来源（生产环境改为你的域名）
APP_CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 用于密码重置邮件中的链接
APP_BASE_URL=https://your-domain.com

# ============ 数据库 ============
DB_HOST=localhost
DB_PORT=3306
DB_USER=labinherit
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=labinherit
DB_ECHO=false

# ============ JWT（必须改成 32 位随机字符串）============
JWT_SECRET=CHANGE_ME_TO_32_CHAR_RANDOM_STRING_abcdef1234567890
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============ SMTP（配置真实邮箱服务器）============
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=noreply@your-domain.com
SMTP_TLS=true

# ============ 看板规则 ============
STALE_DAYS=90

# ============ Worker ============
EMAIL_WORKER_POLL_INTERVAL=5
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_MAX_RETRIES=5

# ============ 上传文件 ============
# 生产环境使用绝对路径
UPLOAD_DIR=/data/labinherit/uploads
